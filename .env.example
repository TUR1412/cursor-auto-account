# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cursor_accounts

# 可选：直接指定数据库连接（测试/本地推荐使用sqlite）
# 例：DATABASE_URL=sqlite:///data.db
DATABASE_URL=

# JWT配置
SECRET_KEY=your_secret_key
TOKEN_EXPIRY_DAYS=30

# 日志配置
LOG_LEVEL=INFO
# LOG_FORMAT=text|json
LOG_FORMAT=text

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
