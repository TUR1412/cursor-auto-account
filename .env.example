# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cursor_accounts

# 可选：直接指定数据库连接（测试/本地推荐使用sqlite）
# 例：DATABASE_URL=sqlite:///data.db
DATABASE_URL=

# 数据库迁移模式（可选）
# create_all（默认）：启动时使用 SQLAlchemy db.create_all() 创建表
# alembic：启动时执行 Alembic 迁移（新库推荐；老库请先 alembic stamp head）
DB_MIGRATION_MODE=create_all

# JWT配置
SECRET_KEY=your_secret_key
TOKEN_EXPIRY_DAYS=30

# 账号密码加密（可选，推荐生产环境配置）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=

# 日志配置
LOG_LEVEL=INFO
# LOG_FORMAT=text|json
LOG_FORMAT=text

# 配置校验（可选）
# true：遇到关键配置错误将启动失败（生产环境建议开启）
CONFIG_STRICT=false

# 指标接口保护（可选）
# 设置后，/metrics 需要携带 Authorization: Bearer <token> 或 X-Metrics-Token
METRICS_TOKEN=

# 轻量限流（可选）
RATE_LIMIT_ENABLED=true
# 内存桶上限（仅用于防止极端情况下的无界增长）
RATE_LIMIT_MAX_BUCKETS=5000

# 安全开关（可选）
# 是否允许用户自助注册（生产环境建议关闭，改为管理员创建账号/白名单）
ALLOW_SELF_REGISTER=true
# 是否允许管理员批量导出账号密码（强风险操作，默认关闭）
ALLOW_ADMIN_PASSWORD_EXPORT=false

# 管理员账号
ADMIN_USERNAME=admin
# 若显式设置 ADMIN_PASSWORD，则启动时会同步更新管理员密码；未设置则不会覆盖已有密码
ADMIN_PASSWORD=admin
# 可选：管理员用户 ID 白名单（逗号分隔）
ADMIN_USER_IDS=
